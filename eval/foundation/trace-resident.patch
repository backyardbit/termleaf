diff --git a/src/trace.rs b/src/trace.rs
new file mode 100644
index 0000000..a9690c3
--- /dev/null
+++ b/src/trace.rs
@@ -0,0 +1,148 @@
+use std::fmt::Write as _;
+use std::fs::File;
+use std::io::{BufWriter, Write};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+static SINK: OnceLock<Option<Mutex<BufWriter<File>>>> = OnceLock::new();
+static START: OnceLock<Instant> = OnceLock::new();
+static NEXT_TID: AtomicU64 = AtomicU64::new(1);
+static INPUTS: AtomicU64 = AtomicU64::new(0);
+static FRAMES: AtomicU64 = AtomicU64::new(0);
+static HANDLED: AtomicU64 = AtomicU64::new(0);
+
+thread_local! {
+    static TID: u64 = NEXT_TID.fetch_add(1, Ordering::Relaxed);
+}
+
+fn sink() -> Option<&'static Mutex<BufWriter<File>>> {
+    SINK.get_or_init(|| {
+        START.get_or_init(Instant::now);
+        let path = std::env::var_os("TERMLEAF_TRACE")?;
+        let file = File::create(path).ok()?;
+        let mut writer = BufWriter::with_capacity(1 << 22, file);
+        let _ = writer.write_all(b"[\n");
+        Some(Mutex::new(writer))
+    })
+    .as_ref()
+}
+
+pub fn enabled() -> bool {
+    sink().is_some()
+}
+
+pub fn marks() -> bool {
+    std::env::var_os("TERMLEAF_FRAME_MARKS").is_some()
+}
+
+fn now_us() -> f64 {
+    START.get_or_init(Instant::now).elapsed().as_secs_f64() * 1e6
+}
+
+fn tid() -> u64 {
+    TID.with(|tid| *tid)
+}
+
+fn emit(line: &str) {
+    if let Some(sink) = sink()
+        && let Ok(mut writer) = sink.lock()
+    {
+        let _ = writer.write_all(line.as_bytes());
+    }
+}
+
+pub fn name_thread(name: &str) {
+    if enabled() {
+        emit(&format!(
+            "{{\"ph\":\"M\",\"name\":\"thread_name\",\"pid\":1,\"tid\":{},\"args\":{{\"name\":\"{name}\"}}}},\n",
+            tid()
+        ));
+    }
+}
+
+pub struct Span {
+    name: &'static str,
+    start: f64,
+    args: String,
+    live: bool,
+}
+
+pub fn span(name: &'static str) -> Span {
+    let live = enabled();
+    Span {
+        name,
+        start: if live { now_us() } else { 0.0 },
+        args: String::new(),
+        live,
+    }
+}
+
+impl Span {
+    pub fn arg(&mut self, key: &str, value: impl std::fmt::Display) {
+        if self.live {
+            if !self.args.is_empty() {
+                self.args.push(',');
+            }
+            let _ = write!(self.args, "\"{key}\":\"{value}\"");
+        }
+    }
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        if self.live {
+            let end = now_us();
+            emit(&format!(
+                "{{\"ph\":\"X\",\"name\":\"{}\",\"pid\":1,\"tid\":{},\"ts\":{:.1},\"dur\":{:.1},\"args\":{{{}}}}},\n",
+                self.name,
+                tid(),
+                self.start,
+                end - self.start,
+                self.args
+            ));
+        }
+    }
+}
+
+pub fn instant(name: &str, args: &str) {
+    if enabled() {
+        emit(&format!(
+            "{{\"ph\":\"i\",\"s\":\"t\",\"name\":\"{name}\",\"pid\":1,\"tid\":{},\"ts\":{:.1},\"args\":{{{args}}}}},\n",
+            tid(),
+            now_us()
+        ));
+    }
+}
+
+pub fn input() -> u64 {
+    let seq = INPUTS.fetch_add(1, Ordering::Relaxed) + 1;
+    instant("input", &format!("\"seq\":{seq}"));
+    seq
+}
+
+pub fn handled() {
+    HANDLED.fetch_add(1, Ordering::Relaxed);
+}
+
+pub fn inputs() -> u64 {
+    HANDLED.load(Ordering::Relaxed)
+}
+
+pub fn frame_mark(holes: usize, tiles: usize) -> Option<String> {
+    let frame = FRAMES.fetch_add(1, Ordering::Relaxed) + 1;
+    let handled = inputs();
+    instant(
+        "frame",
+        &format!("\"frame\":{frame},\"inputs\":{handled},\"holes\":{holes},\"tiles\":{tiles}"),
+    );
+    marks().then(|| format!("\x1b]7777;f;{frame};{handled};{holes};{tiles}\x07"))
+}
+
+pub fn flush() {
+    if let Some(sink) = sink()
+        && let Ok(mut writer) = sink.lock()
+    {
+        let _ = writer.flush();
+    }
+}
